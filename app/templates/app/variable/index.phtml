<?php

use Tragwerk\Domain\Entity\EnvVar;

$activeEnvironment = $this->activeEnvironment();

// A variable is editable here if it is defined in the scope currently in view: project-wide
// variables always, branch-local ones only on their own environment.
$isEditableHere = static fn(EnvVar $var): bool => $var->branch === null || $var->branch === $activeEnvironment;

$this->layout('layout::default', [
    'pageType' =>  $this->activeTeam()->name . ($activeEnvironment !== null ? ' / ' . $activeEnvironment : ''),
    'pageTitle' => $this->t('Environment variables'),
    'pageSubTitle' => sprintf(
        $this->t('%d variables · %d secret · %d project-wide — injected at build and runtime.'),
        count($vars),
        count(array_filter($vars, static fn(EnvVar $e) => $e->isSecret)),
        count(array_filter($vars, static fn(EnvVar $e) => $e->branch === null)),
    ),
]) ?>

<?php $this->start('pageHeadButtons') ?>
    <?= $this->fetch('partial::link', [
        'label'   => $this->t('New variable'),
        'href'    => $this->url('variable.create'),
        'icon'    => 'bi bi-plus-lg',
        'classes' => 'btn btn-primary',
    ]) ?>
<?php $this->stop() ?>

<?php if ($activeEnvironment === null): ?>
    <div class="tw-card mb-3">
        <div class="tw-card__body d-flex align-items-start gap-3">
            <i class="bi bi-info-circle" style="color:var(--text-faint)"></i>
            <div>
                <div class="tw-cell-strong"><?= $this->e($this->t('No environment yet')) ?></div>
                <div class="text-muted-2" style="font-size:.85rem">
                    <?= $this->e($this->t('Variables you create now apply to the whole project, so the first build already has them. Once you push a branch you can add values for that environment only.')) ?>
                </div>
            </div>
        </div>
    </div>
<?php endif ?>

<?php if ($vars === []): ?>
    <div class="tw-card">
        <div class="tw-card__body text-center py-5">
            <div class="text-faint mb-2"><i class="bi bi-sliders" style="font-size:1.5rem"></i></div>
            <div class="tw-cell-strong mb-1"><?= $this->e($this->t('No variables yet')) ?></div>
            <div class="text-muted-2 mb-3" style="font-size:.85rem"><?= $this->e($this->t('Add the configuration and secrets your application needs at build and runtime.')) ?></div>
            <?= $this->fetch('partial::link', [
                'label'   => $this->t('New variable'),
                'href'    => $this->url('variable.create'),
                'icon'    => 'bi bi-plus-lg',
                'classes' => 'btn btn-primary',
            ]) ?>
        </div>
    </div>
<?php else: ?>
<div class="tw-table-wrap">
    <table class="tw-table">
        <thead>
        <tr>
            <th class="sortable">Key <i class="bi bi-chevron-expand"></i></th>
            <th>Value</th>
            <th>Properties</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        <?php
        /** @var EnvVar $var */
        foreach ($vars as $var):?>
        <tr>
            <td><a href="<?= $this->e($this->url('variable.edit', ['id' => $var->id])) ?>" class="tw-cell-strong mono" style="color:var(--text)"><?= $this->e($var->key) ?></a></td>
            <td>
                <div class="var-value">
                    <?php if($var->isSecret): ?>
                        <code><?= $this->e(substr(str_repeat("*", strlen($var->value)), 0, 10)) ?></code>
                    <?php else: ?>
                        <code><?= $this->e(substr($var->value, 0, 40)) ?></code>
                    <?php endif ?>
                </div>
            </td>
            <td>
                <div class="d-flex gap-1 flex-wrap">
                    <?php if($var->isSecret): ?>
                        <span class="tw-badge tw-badge--warn"><i class="bi bi-lock-fill" style="font-size:.7rem"></i><?= $this->e($this->t('Secret')) ?></span>
                    <?php endif ?>
                    <?php if($var->branch === null): ?>
                        <span class="tw-badge tw-badge--info"><i class="bi bi-collection" style="font-size:.7rem"></i><?= $this->e($this->t('All environments')) ?></span>
                    <?php endif ?>
                    <?php if($var->isInherited): ?>
                        <span class="tw-badge tw-badge--info"><i class="bi bi-diagram-2" style="font-size:.7rem"></i><?= $this->e($this->t('Inherited')) ?></span>
                    <?php endif ?>
                    <?php if($var->branch !== null && $var->branch === $activeEnvironment && $var->isInherited === false): ?>
                        <span class="tw-badge tw-badge--neutral"><i class="tw-dot" style="font-size:.7rem"></i><?= $this->e($this->t('This environment only')) ?></span>
                    <?php endif ?>
                </div>
            </td>
            <td class="text-end">
                <?php if($isEditableHere($var)): ?>
                <div class="d-flex justify-content-end gap-1">
                    <a class="btn btn-ghost btn-sm" href="<?= $this->url('variable.edit', ['id' => $var->id->toString()]) ?>" title="<?= $this->e($this->t('Edit')) ?>"><i class="bi bi-pencil"></i></a>
                    <button class="btn btn-ghost btn-sm" type="button" data-bs-toggle="modal" data-bs-target="#tw-delete-variable-<?= $this->e($var->id->toString()) ?>" title="<?= $this->e($this->t('Delete')) ?>"><i class="bi bi-trash3"></i></button>
                </div>
                <?php endif ?>
            </td>
        </tr>
        <?php endforeach ?>
        </tbody>
    </table>
</div>
<?php endif ?>

<?php
/** @var EnvVar $var */
foreach ($vars as $var):
    if (! $isEditableHere($var)) {
        continue;
    }
    ?>
    <?= $this->fetch('partial::modal', [
        'id'            => 'tw-delete-variable-' . $var->id->toString(),
        'header'        => $this->t('Delete variable'),
        'body'          => $this->t('Are you sure you want to delete {key}? The variable will no longer be available after the next deploy.', ['key' => '<b class="mono">' . $this->e($var->key) . '</b>']),
        'actionUrl'     => $this->url('variable.delete', ['id' => $var->id->toString()]),
        'actionLabel'   => $this->t('Delete'),
        'actionClasses' => 'btn btn-danger',
        'actionIcon'    => 'bi bi-trash3',
    ]) ?>
<?php endforeach ?>
